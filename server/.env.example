# Server Configuration
PORT=8000
TESTING=False

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=AI-Courtroom
TEST_MONGODB_DB_NAME=AI-Courtroom-Test

# Security & Authentication
# Required: generate with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
EXTENDED_TOKEN_EXPIRE_DAYS=7

# CORS & Frontend Integration
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:3000,capacitor://localhost,ionic://localhost
CORS_ALLOW_ORIGIN_REGEX=

# AI Providers (API Keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Developer mode: comma-separated emails that can see which AI model answered
# (X-LLM-Models response header + client panel). Leave empty in production
# unless you want it for your own account.
DEV_MODE_EMAILS=

# Per-Task LLM Configuration (Optional overrides)
# DRAFTER_MODEL=openai/gpt-oss-120b
# DRAFTER_PROVIDER=groq
# DRAFTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# DRAFTER_FALLBACK_PROVIDER=openrouter
# DRAFTER_FALLBACK2_MODEL=inclusionai/ling-3.0-flash-sante:free
# DRAFTER_FALLBACK2_PROVIDER=openrouter

# LAWYER_MODEL=openai/gpt-oss-120b
# LAWYER_PROVIDER=groq
# LAWYER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LAWYER_FALLBACK_PROVIDER=openrouter
# LAWYER_FALLBACK2_MODEL=qwen/qwen3.8-27b
# LAWYER_FALLBACK2_PROVIDER=groq

# JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# JUDGE_PROVIDER=openrouter
# JUDGE_FALLBACK_MODEL=openai/gpt-oss-120b
# JUDGE_FALLBACK_PROVIDER=groq
# JUDGE_FALLBACK2_MODEL=inclusionai/ling-3.0-flash-sante:free
# JUDGE_FALLBACK2_PROVIDER=openrouter

# ANALYZER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ANALYZER_PROVIDER=openrouter
# ANALYZER_FALLBACK_MODEL=openai/gpt-oss-120b
# ANALYZER_FALLBACK_PROVIDER=groq
# ANALYZER_FALLBACK2_MODEL=inclusionai/ling-3.0-flash-sante:free
# ANALYZER_FALLBACK2_PROVIDER=openrouter

# OUTCOME_MODEL=openai/gpt-oss-20b
# OUTCOME_PROVIDER=groq
# OUTCOME_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OUTCOME_FALLBACK_PROVIDER=openrouter
# OUTCOME_FALLBACK2_MODEL=openai/gpt-oss-120b
# OUTCOME_FALLBACK2_PROVIDER=groq

# PARTY_MODEL=qwen/qwen3.8-27b
# PARTY_PROVIDER=groq
# PARTY_FALLBACK_MODEL=inclusionai/ling-3.0-flash-sante:free
# PARTY_FALLBACK_PROVIDER=openrouter
# PARTY_FALLBACK2_MODEL=openai/gpt-oss-20b
# PARTY_FALLBACK2_PROVIDER=groq

# WITNESS_MODEL=qwen/qwen3.8-27b
# WITNESS_PROVIDER=groq
# WITNESS_FALLBACK_MODEL=inclusionai/ling-3.0-flash-sante:free
# WITNESS_FALLBACK_PROVIDER=openrouter
# WITNESS_FALLBACK2_MODEL=openai/gpt-oss-20b
# WITNESS_FALLBACK2_PROVIDER=groq

# Unused/Legacy model config
llm_model=meta-llama/llama-4-scout-17b-16e-instruct

# RAG & Local Embeddings
RAG_ENABLED=True
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=8
RAG_MIN_SCORE=0.25

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required, same way as SECRET_KEY
OAUTH_STATE_SECRET=
OAUTH_STATE_TOKEN_EXPIRY=600

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Cloudflare (Evidence Image Generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EVIDENCE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
EVIDENCE_IMAGE_FALLBACK_MODEL=@cf/black-forest-labs/flux-2-dev
EVIDENCE_IMAGE_GENERATION_LIMIT_PER_CASE=2
EVIDENCE_IMAGE_GENERATION_TIMEOUT_SECONDS=120

# Email SMTP Service
email_sender=noreply@example.com
email_username=
email_password=
smtp_server=smtp.gmail.com
smtp_port=587

# GeoLocation API
CSC_API_KEY=

# Rate Limiting
CASE_GENERATION_RATE_LIMIT=5
CASE_GENERATION_RATE_WINDOW=86400
ARGUMENT_RATE_LIMIT=10
ARGUMENT_RATE_WINDOW=86400
OTP_SEND_LIMIT=3
OTP_SEND_WINDOW=600
OTP_MAX_ATTEMPTS=5
OTP_EXPIRE_MINUTES=10
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_IP_LIMIT=20
LOGIN_FAILURE_WINDOW=900
PARTY_CHAT_RATE_LIMIT=5
PARTY_CHAT_RATE_WINDOW=60
CLIENT_LOG_RATE_LIMIT=30
CLIENT_LOG_RATE_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI lawyer conferences and recess
COUNSEL_QUESTIONS_PER_ROUND=2
COUNSEL_QUESTIONS_PER_PARTY=6
COUNSEL_RECESS_MIN_SECONDS=60
COUNSEL_RECESS_MAX_SECONDS=180

# How much the AI reads (characters / items)
FULL_TEXT_PROCEEDINGS_LIMIT=16000
PROCEEDINGS_SUMMARY_RESERVE=2000
PROCEEDINGS_SUMMARY_BATCH=10
COUNSEL_CONFERENCE_TEXT_LIMIT=6000
ANALYSIS_SECTION_LIMIT=20000
RECENT_HISTORY_LIMIT=8
WITNESS_HISTORY_LIMIT=8

# Short AI replies are retried
MIN_AI_RESPONSE_CHARS=20
MAX_SHORT_RESPONSE_RETRIES=2

# Model temperatures
DEFAULT_TEMPERATURE=0.7
JUDGE_TEMPERATURE=0.2
ANALYZER_TEMPERATURE=0.3
DRAFTER_TEMPERATURE=0.8

CNR_MAX_ESTABLISHMENT_CODE=20
