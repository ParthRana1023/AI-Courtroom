{
  "name": "ai-courtroom",
  "version": "5.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:pwa": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "build:mobile": "cross-env CAPACITOR_BUILD=true next build --webpack",
    "cap:sync": "cap sync",
    "build:android": "pnpm build:mobile && cross-env CAP_ENV_FILE=.env.production cap sync android",
    "build:ios": "pnpm build:mobile && cross-env CAP_ENV_FILE=.env.production cap sync ios",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "test:e2e": "playwright test -c e2e",
    "test:e2e:fast": "playwright test -c e2e --project=desktop",
    "test:e2e:update": "playwright test -c e2e --update-snapshots"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capawesome/capacitor-google-sign-in": "^0.1.4",
    "@react-oauth/google": "^0.13.5",
    "@serwist/next": "^9.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "monocart-reporter": "^2.14.1",
    "postcss": "^8.5.30",
    "serwist": "^9.5.13",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
