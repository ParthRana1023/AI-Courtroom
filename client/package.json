{
  "name": "ai-courtroom",
  "version": "4.10.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:pwa": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "build:mobile": "cross-env CAPACITOR_BUILD=true next build --webpack",
    "cap:sync": "cap sync",
    "build:android": "pnpm build:mobile && cap sync android",
    "build:ios": "pnpm build:mobile && cap sync ios",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "test:e2e": "playwright test -c e2e",
    "test:e2e:update": "playwright test -c e2e --update-snapshots"
  },
