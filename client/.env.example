# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth
# Must be NEXT_PUBLIC_ prefixed so it is exposed to the browser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Diagnostics & Remote Logging
NEXT_PUBLIC_LOG_REMOTE_ENABLED=false

# Mobile Build (Capacitor)
CAPACITOR_BUILD=false
CAP_SERVER_URL=http://localhost:3000

# Courtroom timings (milliseconds) and AI witness checks
NEXT_PUBLIC_COURT_ADJOURN_DELAY_MS=8000
NEXT_PUBLIC_COURTROOM_POLL_MS=4000
NEXT_PUBLIC_WITNESS_PANEL_POLL_MS=4000
NEXT_PUBLIC_AI_EXAMINATION_POLL_MS=1000
NEXT_PUBLIC_MIN_ARGUMENTS_BETWEEN_AI_WITNESS_CHECKS=2
NEXT_PUBLIC_WITNESS_CHECK_COOLDOWN_MS=30000
